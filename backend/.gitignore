# Node modules
node_modules/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# dotenv environment variables
.env

# Par défaut, ignorer tout le contenu des uploads
uploads/*

# MAIS garder les dossiers eux-mêmes
!uploads/*/

# Cas spécifiques par dossier :

# 1. goals_images/ : dossier vide (avec .gitkeep)
uploads/goals_images/*
!uploads/goals_images/.gitkeep

# 2. targets_images/ : dossier vide (avec .gitkeep)  
uploads/targets_images/*
!uploads/targets_images/.gitkeep

# 3. users_images/ : contenu inclus (rien à ignorer pour ce dossier)
# (pas de règle = le contenu sera inclus)

# Exception : permettre le contenu de users_images/
!uploads/users_images/
!uploads/users_images/**

# OS files
.DS_Store
Thumbs.db

# Coverage directory
coverage/

# Build output
dist/
build/

#backup de la base de données
backup_pg/